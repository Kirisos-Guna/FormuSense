# Copy to .env and edit. Every value here is optional: with none of them set, the
# application runs on the bundled SQLite database and needs nothing installed.

# --- Database -----------------------------------------------------------------
# Default (offline, zero-install): the bundled SQLite file.
# FORMUSENSE_DB_URL=sqlite:///app/data/formusense.db
# Production target: PostgreSQL (needs a driver: pip install "psycopg[binary]").
# FORMUSENSE_DB_URL=postgresql://formu:formu@localhost:5432/formusense

# --- Server -------------------------------------------------------------------
# FORMUSENSE_HOST=127.0.0.1
# FORMUSENSE_PORT=8770
# FORMUSENSE_LOG_LEVEL=INFO
# FORMUSENSE_LOG_REQUESTS=1

# --- Security -----------------------------------------------------------------
# When set, POST and DELETE routes require: Authorization: Bearer <token>
# FORMUSENSE_AUTH_TOKEN=

# --- Optional AI layer (OpenRouter) -------------------------------------------
# The offline image analysis always runs. A key adds a model that describes the
# reference photographs, reviews the specification against what the parser already
# found, and answers questions from the product's own record. It never sets a
# target, a pack size or a cost.
#
# OpenRouter is the provider this is built around: one key reaches every vendor's
# models, so a deployment needs a single secret. Any model id OpenRouter serves
# works, including the ":free" variants, which is how to demonstrate it with no
# credit balance at all.
#
# The defaults are free models, so nothing is spent and no credit balance is needed.
# A comma-separated list is tried in order, and the free pools are separate, so more
# than one free model is what keeps a demonstration alive when one pool is busy:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# A paid model may be added the same way, and will be spent only if it is reached:
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free,qwen/qwen3.8-27b
# A different provider is reached through the same code path, not a different one:
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- AI guardrails -------------------------------------------------------------
# The model runs only when a run asks for it. These bound what it can spend.
# OPENROUTER_APP_TITLE=FormuSense
# OPENROUTER_HTTP_REFERER=https://formusense.onrender.com
# FORMUSENSE_AI=1                       # 0 switches the layer off even with a key set
# FORMUSENSE_AI_MODEL=                  # overrides the model for whichever key is used
# FORMUSENSE_AI_TIMEOUT=45
# FORMUSENSE_AI_MAX_TOKENS=700          # raise it if a model thinks until it runs out
# FORMUSENSE_AI_MAX_IMAGES=3
# FORMUSENSE_AI_MAX_CALLS_PER_HOUR=60   # 0 means no hourly ceiling
# How many times a model may answer 429 before the next one is tried. A refused
# request is free, so this is a few seconds rather than a few rupees.
# FORMUSENSE_AI_RETRIES=2
# Thinking before answering, which these prompts do not need: off, low, medium, high,
# or anything else to leave it to the model. Measured on the default model, turning
# it off was three times faster on a fifth of the output tokens.
# FORMUSENSE_AI_REASONING=off
