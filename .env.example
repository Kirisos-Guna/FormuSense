# Copy to .env and edit. Every value here is optional: with none of them set, the
# application runs on the bundled SQLite database and needs nothing installed.

# --- Database -----------------------------------------------------------------
# Default (offline, zero-install): the bundled SQLite file.
# FORMUSENSE_DB_URL=sqlite:///app/data/formusense.db
# Production target: PostgreSQL (needs a driver: pip install "psycopg[binary]").
# FORMUSENSE_DB_URL=postgresql://formu:formu@localhost:5432/formusense

# --- Server -------------------------------------------------------------------
# FORMUSENSE_HOST=127.0.0.1
# FORMUSENSE_PORT=8770
# FORMUSENSE_LOG_LEVEL=INFO
# FORMUSENSE_LOG_REQUESTS=1

# --- Security -----------------------------------------------------------------
# When set, POST and DELETE routes require: Authorization: Bearer <token>
# FORMUSENSE_AUTH_TOKEN=

# --- Optional vision layer ----------------------------------------------------
# The offline Pillow analysis always runs; a key adds a semantic description.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
