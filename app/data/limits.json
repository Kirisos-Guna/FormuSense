  "microbial_safety_rules": [
    {"id": "aw_dry", "condition": "water_activity <= 0.60", "implication": "Dry product - mould growth inhibited; control moisture pickup and packaging barrier.", "risk": "low"},
    {"id": "aw_intermediate", "condition": "0.60 < water_activity <= 0.85", "implication": "Intermediate moisture - hurdle technology required (pH, preservative, aw, heat).", "risk": "medium"},
    {"id": "aw_high", "condition": "water_activity > 0.85", "implication": "High moisture - requires refrigeration, sterilisation or acidification below pH 4.6.", "risk": "high"},
    {"id": "acidified", "condition": "pH <= 4.6", "implication": "Acidified food - Clostridium botulinum vegetative growth inhibited when pH <= 4.6.", "risk": "low"},
    {"id": "low_acid", "condition": "pH > 4.6 and water_activity > 0.85", "implication": "Low acid, high moisture - pathogen growth risk; requires a validated thermal process.", "risk": "high"}
