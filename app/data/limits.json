    "spread": {"preservative_ppm_max": 200, "preservative_note": "sorbate/benzoate class II preservative; benzoate only in acidic products", "sweetener_intense": "permitted in specified low-calorie categories", "colour": "permitted colours only"},
    "drymix": {"preservative_ppm_max": 1000, "sweetener_intense": "verify per category", "colour": "natural colours preferred"},
